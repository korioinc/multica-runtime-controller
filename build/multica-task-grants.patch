new file mode 100644
--- /dev/null
+++ b/server/internal/daemon/task_repo_grants_identity_unix.go
@@ -0,0 +1,17 @@
+//go:build linux || darwin
+
+package daemon
+
+import (
+	"fmt"
+	"os"
+	"syscall"
+)
+
+func taskRepoGrantFileIdentity(info os.FileInfo) (uint64, uint64, error) {
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return 0, 0, fmt.Errorf("repository grant directory has no durable file identity")
+	}
+	return uint64(stat.Dev), uint64(stat.Ino), nil
+}
