+func TestTaskRepoGrantsRetryAfterPriorRootReuse(t *testing.T) {
+	d, _, cleanup := newLeaderReuseTestDaemon(t)
+	defer cleanup()
+	d.cfg.WorkspacesRoot = filepath.Join(t.TempDir(), "workspaces")
+	first := leaderReuseTestTask("retry-origin")
+	first.Repos = []RepoData{{URL: "https://github.com/team/private-a.git"}}
+	prior, err := d.runTask(context.Background(), first, "claude", 0, d.logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const workingData = "authorized-uncommitted-retry-work"
+	if err := os.WriteFile(filepath.Join(prior.WorkDir, "protected-repository-data"), []byte(workingData), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	bin := d.cfg.Agents["claude"].Path
+	script := `#!/bin/sh
+IFS= read -r _
+content=clean
+if [ -f protected-repository-data ]; then content=$(cat protected-repository-data); fi
+printf '{"type":"result","subtype":"success","is_error":false,"result":"%s"}\n' "$content"
+`
+	if err := os.WriteFile(bin, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	followup := leaderReuseTestTask("retry-followup")
+	followup.Repos = first.Repos
+	followup.PriorWorkDir, followup.PriorSessionID = prior.WorkDir, prior.SessionID
+	if _, err := d.runTask(context.Background(), followup, "claude", 0, d.logger); err != nil {
+		t.Fatal(err)
+	}
+	// The same task is dispatched again with the same authorized prior work.
+	// Its unused fresh candidate directory must not block the retry.
+	retried, err := d.runTask(context.Background(), followup, "claude", 0, d.logger)
+	if err != nil {
+		t.Fatalf("same-task retry after prior-root reuse failed: %v", err)
+	}
+	if !strings.Contains(retried.Comment, workingData) {
+		t.Fatal("same-task retry lost its authorized in-progress working data")
+	}
+}
