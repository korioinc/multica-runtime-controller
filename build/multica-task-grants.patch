diff --git a/server/internal/daemon/task_repo_grants.go b/server/internal/daemon/task_repo_grants.go
new file mode 100644
--- /dev/null
+++ b/server/internal/daemon/task_repo_grants.go
@@ -0,0 +1,276 @@
+package daemon
+
+import (
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/multica-ai/multica/server/internal/daemon/execenv"
+)
+
+// Consume the controller-only Secret before discovery or preparation can spawn
+// a child. The key never lives on the worker-writable workspace PVC and is
+// stable across controller restarts. Legacy workers cannot forge signed grants.
+var controllerRepoGrantKey, controllerRepoGrantKeyErr = consumeControllerRepoGrantKey()
+
+func consumeControllerRepoGrantKey() ([]byte, error) {
+	value := os.Getenv("MULTICA_CONTROLLER_GRANT_KEY")
+	if err := os.Unsetenv("MULTICA_CONTROLLER_GRANT_KEY"); err != nil {
+		return nil, errors.New("remove controller repository grant signing key from environment")
+	}
+	key, err := hex.DecodeString(value)
+	if err != nil || len(key) != 32 {
+		return nil, errors.New("controller repository grant signing key is missing or invalid")
+	}
+	return key, nil
+}
+
+type taskRepoGrant struct {
+	Version       int      `json:"version"`
+	Root          string   `json:"root"`
+	Device        uint64   `json:"device"`
+	Inode         uint64   `json:"inode"`
+	WorkspaceID   string   `json:"workspace_id"`
+	AgentID       string   `json:"agent_id"`
+	IssueID       string   `json:"issue_id"`
+	ChatSessionID string   `json:"chat_session_id"`
+	Repos         []string `json:"repos"`
+}
+
+type signedTaskRepoGrant struct {
+	Grant     taskRepoGrant `json:"grant"`
+	Signature string        `json:"signature"`
+}
+
+func currentTaskRepoGrant(workspacesRoot, envRoot string, task Task) (taskRepoGrant, error) {
+	root, err := filepath.EvalSymlinks(workspacesRoot)
+	if err != nil {
+		return taskRepoGrant{}, err
+	}
+	canonical, err := filepath.EvalSymlinks(envRoot)
+	if err != nil {
+		return taskRepoGrant{}, err
+	}
+	rel, err := filepath.Rel(root, canonical)
+	if err != nil || !filepath.IsLocal(rel) || len(strings.Split(rel, string(filepath.Separator))) != 2 {
+		return taskRepoGrant{}, errors.New("repository grant root is not a managed task directory")
+	}
+	info, err := os.Stat(canonical)
+	if err != nil || !info.IsDir() {
+		return taskRepoGrant{}, errors.New("repository grant root is not an existing directory")
+	}
+	device, inode, err := taskRepoGrantFileIdentity(info)
+	if err != nil {
+		return taskRepoGrant{}, err
+	}
+	repos := make([]string, 0, len(task.Repos))
+	for _, repo := range task.Repos {
+		// Match the daemon's authorization semantics. Do not collapse distinct
+		// URLs (hosts, paths, URL credentials) into the same visibility grant.
+		if url := strings.TrimSpace(repo.URL); url != "" {
+			repos = append(repos, url)
+		}
+	}
+	slices.Sort(repos)
+	repos = slices.Compact(repos)
+	return taskRepoGrant{
+		Version: 1, Root: canonical, Device: device, Inode: inode,
+		WorkspaceID: task.WorkspaceID, AgentID: task.AgentID,
+		IssueID: task.IssueID, ChatSessionID: task.ChatSessionID, Repos: repos,
+	}, nil
+}
+
+func taskRepoGrantName(envRoot string) string {
+	sum := sha256.Sum256([]byte(envRoot))
+	return hex.EncodeToString(sum[:]) + ".json"
+}
+
+// Every registry operation stays on pinned directory handles. In particular,
+// a symlink left on the old shared PVC cannot redirect a controller write.
+func openTaskRepoGrantRegistry(workspacesRoot string, create bool) (*os.Root, error) {
+	root, err := os.OpenRoot(workspacesRoot)
+	if err != nil {
+		return nil, err
+	}
+	for _, name := range []string{".runtime-controller", "repo-grants"} {
+		if create {
+			if err := root.Mkdir(name, 0o700); err != nil && !errors.Is(err, os.ErrExist) {
+				root.Close()
+				return nil, err
+			}
+		}
+		info, err := root.Lstat(name)
+		if err != nil {
+			root.Close()
+			return nil, err
+		}
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			root.Close()
+			return nil, errors.New("repository grant registry must use real directories")
+		}
+		next, err := root.OpenRoot(name)
+		root.Close()
+		if err != nil {
+			return nil, err
+		}
+		opened, err := next.Stat(".")
+		if err != nil || !os.SameFile(info, opened) {
+			next.Close()
+			return nil, errors.New("repository grant registry changed identity")
+		}
+		root = next
+	}
+	return root, nil
+}
+
+func taskRepoGrantSignature(grant taskRepoGrant) ([]byte, error) {
+	if controllerRepoGrantKeyErr != nil {
+		return nil, controllerRepoGrantKeyErr
+	}
+	payload, err := json.Marshal(grant)
+	if err != nil {
+		return nil, err
+	}
+	mac := hmac.New(sha256.New, controllerRepoGrantKey)
+	_, _ = mac.Write(payload)
+	return mac.Sum(nil), nil
+}
+
+func readTaskRepoGrant(workspacesRoot, canonicalRoot string) (taskRepoGrant, error) {
+	registry, err := openTaskRepoGrantRegistry(workspacesRoot, false)
+	if err != nil {
+		return taskRepoGrant{}, err
+	}
+	defer registry.Close()
+	name := taskRepoGrantName(canonicalRoot)
+	info, err := registry.Lstat(name)
+	if err != nil {
+		return taskRepoGrant{}, err
+	}
+	if !info.Mode().IsRegular() {
+		return taskRepoGrant{}, errors.New("repository grant record must be a regular file")
+	}
+	file, err := registry.Open(name)
+	if err != nil {
+		return taskRepoGrant{}, err
+	}
+	defer file.Close()
+	opened, err := file.Stat()
+	if err != nil || !os.SameFile(info, opened) {
+		return taskRepoGrant{}, errors.New("repository grant record changed identity")
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 1024*1024))
+	if err != nil {
+		return taskRepoGrant{}, err
+	}
+	var record signedTaskRepoGrant
+	if err := json.Unmarshal(data, &record); err != nil {
+		return taskRepoGrant{}, err
+	}
+	want, err := taskRepoGrantSignature(record.Grant)
+	if err != nil {
+		return taskRepoGrant{}, err
+	}
+	signature, err := hex.DecodeString(record.Signature)
+	if err != nil || !hmac.Equal(signature, want) {
+		return taskRepoGrant{}, errors.New("repository grant record has no valid controller signature")
+	}
+	return record.Grant, nil
+}
+
+func taskRepoGrantMatches(workspacesRoot, envRoot string, task Task) bool {
+	current, err := currentTaskRepoGrant(workspacesRoot, envRoot, task)
+	if err != nil {
+		return false
+	}
+	prior, err := readTaskRepoGrant(workspacesRoot, current.Root)
+	return err == nil && prior.Version == current.Version && prior.Root == current.Root &&
+		prior.Device == current.Device && prior.Inode == current.Inode &&
+		prior.WorkspaceID == current.WorkspaceID && prior.AgentID == current.AgentID &&
+		prior.IssueID == current.IssueID && prior.ChatSessionID == current.ChatSessionID &&
+		slices.Equal(prior.Repos, current.Repos)
+}
+
+func writeTaskRepoGrant(workspacesRoot, envRoot string, task Task) error {
+	grant, err := currentTaskRepoGrant(workspacesRoot, envRoot, task)
+	if err != nil {
+		return err
+	}
+	signature, err := taskRepoGrantSignature(grant)
+	if err != nil {
+		return err
+	}
+	data, err := json.Marshal(signedTaskRepoGrant{Grant: grant, Signature: hex.EncodeToString(signature)})
+	if err != nil {
+		return err
+	}
+	registry, err := openTaskRepoGrantRegistry(workspacesRoot, true)
+	if err != nil {
+		return err
+	}
+	defer registry.Close()
+	temp := ".pending-" + rand.Text()
+	file, err := registry.OpenFile(temp, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return err
+	}
+	defer registry.Remove(temp)
+	if _, err := file.Write(data); err != nil {
+		file.Close()
+		return err
+	}
+	if err := file.Sync(); err != nil {
+		file.Close()
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	if err := registry.Rename(temp, taskRepoGrantName(grant.Root)); err != nil {
+		return err
+	}
+	dir, err := registry.Open(".")
+	if err != nil {
+		return err
+	}
+	defer dir.Close()
+	return dir.Sync()
+}
+
+// A failed grant proof invalidates session history even for providers such as
+// Pi whose transcript is reachable independently of their working directory.
+func gatePriorTaskRepoGrant(task *Task, taskCtx *execenv.TaskContextForEnv, workspacesRoot string) bool {
+	if task.PriorWorkDir != "" && taskRepoGrantMatches(workspacesRoot, filepath.Dir(task.PriorWorkDir), *task) {
+		return true
+	}
+	if task.PriorSessionID != "" {
+		task.PriorSessionID = ""
+		taskCtx.PriorSessionResumed = false
+		taskCtx.PriorSessionResumeUnavailable = true
+		task.PriorSessionResumeUnavailable = true
+	}
+	return false
+}
+
+// ClaimEnvRoot resets an existing directory. Never let a retry erase unknown
+// prior work or re-label it with a different repository grant.
+func validateTaskRepoGrantBeforeClaim(workspacesRoot, envRoot string, task Task) error {
+	if _, err := os.Lstat(envRoot); errors.Is(err, os.ErrNotExist) {
+		return nil
+	} else if err != nil {
+		return err
+	}
+	if !taskRepoGrantMatches(workspacesRoot, envRoot, task) {
+		return fmt.Errorf("refusing existing task directory %s: repository grant cannot be verified; preserve it and dispatch a new task", envRoot)
+	}
+	return nil
+}
