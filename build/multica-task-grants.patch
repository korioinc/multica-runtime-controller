+func TestTaskRepoGrantsDenyCrossRepositoryPiHistory(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	d, _, cleanup := newLeaderReuseTestDaemon(t)
+	defer cleanup()
+	d.cfg.WorkspacesRoot = filepath.Join(t.TempDir(), "workspaces")
+	first := leaderReuseTestTask("session-first")
+	first.Repos = []RepoData{{URL: "https://github.com/team/private-a.git"}}
+	prior, err := d.runTask(context.Background(), first, "claude", 0, d.logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const secret = "repository-a-private-conversation"
+	sessionPath := filepath.Join(t.TempDir(), "prior.jsonl")
+	if err := os.WriteFile(sessionPath, []byte(secret), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	bin := d.cfg.Agents["claude"].Path
+	script := `#!/bin/sh
+while [ "$#" -gt 0 ]; do
+  if [ "$1" = --session ]; then shift; session=$1; fi
+  shift
+done
+cat >/dev/null
+content=clean
+if [ -s "$session" ]; then content=$(cat "$session"); fi
+printf '{"type":"message_update","assistantMessageEvent":{"type":"text_delta","delta":"%s"}}\n' "$content"
+printf '%s\n' '{"type":"turn_end","message":{"role":"assistant","model":"test"}}'
+`
+	if err := os.WriteFile(bin, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	d.cfg.Agents["pi"] = AgentEntry{Path: bin}
+	d.runtimeIndex["rt-leader"] = Runtime{ID: "rt-leader", Provider: "pi"}
+	for _, priorWorkDir := range []string{prior.WorkDir, ""} {
+		task := leaderReuseTestTask("session-followup-" + fmt.Sprint(priorWorkDir == ""))
+		task.Repos = []RepoData{{URL: "https://github.com/team/private-b.git"}}
+		task.PriorWorkDir, task.PriorSessionID = priorWorkDir, sessionPath
+		result, err := d.runTask(context.Background(), task, "pi", 0, d.logger)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(result.Comment, secret) {
+			t.Fatal("repository B read repository A history through a globally reachable Pi session")
+		}
+	}
+	// The same globally stored history remains usable with its signed grant.
+	task := leaderReuseTestTask("session-same-grant")
+	task.Repos = first.Repos
+	task.PriorWorkDir, task.PriorSessionID = prior.WorkDir, sessionPath
+	continued, err := d.runTask(context.Background(), task, "pi", 0, d.logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(continued.Comment, secret) {
+		t.Fatal("same-repository continuation lost its authorized Pi conversation")
+	}
+}
