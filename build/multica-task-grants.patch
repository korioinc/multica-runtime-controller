+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/multica-ai/multica/server/internal/daemon/execenv"
+)
+
+// Exercise the daemon's real selection/preparation and a child process that
+// reads task-local data. The fake provider replaces only the remote model.
+func TestTaskRepoGrantsDenyPriorRepositoryData(t *testing.T) {
+	d, _, cleanup := newLeaderReuseTestDaemon(t)
+	defer cleanup()
+	d.cfg.WorkspacesRoot = filepath.Join(t.TempDir(), "workspaces")
+	bin := d.cfg.Agents["claude"].Path
+	script := `#!/bin/sh
+IFS= read -r _
+content=clean
+if [ -f protected-repository-data ]; then content=$(cat protected-repository-data); fi
+printf '%s\n' '{"type":"system","session_id":"session-grant-test"}'
+printf '{"type":"result","subtype":"success","is_error":false,"session_id":"session-grant-test","result":"%s"}\n' "$content"
+`
+	if err := os.WriteFile(bin, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	first := leaderReuseTestTask("grant-first")
+	first.Repos = []RepoData{{URL: "https://github.com/team/private-a.git"}}
+	prior, err := d.runTask(context.Background(), first, "claude", 0, d.logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const secret = "repository-a-private-source"
+	protected := filepath.Join(prior.WorkDir, "protected-repository-data")
+	if err := os.WriteFile(protected, []byte(secret), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	second := leaderReuseTestTask("grant-second")
+	second.Repos = []RepoData{{URL: "https://github.com/team/private-b.git"}}
+	second.PriorWorkDir, second.PriorSessionID = prior.WorkDir, prior.SessionID
+	result, err := d.runTask(context.Background(), second, "claude", 0, d.logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(result.Comment, secret) {
+		t.Fatal("a task granted only repository B read repository A's private data")
+	}
+	data, err := os.ReadFile(protected)
+	if err != nil || string(data) != secret {
+		t.Fatalf("changing repository grants damaged prior work: %q, %v", data, err)
+	}
+	// Equivalent grant sets keep the actual working data through continuation;
+	// descriptions, revisions, duplicates and ordering do not grant new repos.
+	third := leaderReuseTestTask("grant-third")
+	third.Repos = []RepoData{{URL: first.Repos[0].URL, Ref: "new-branch", Description: "renamed"}, {URL: first.Repos[0].URL}}
+	third.PriorWorkDir, third.PriorSessionID = prior.WorkDir, prior.SessionID
+	continued, err := d.runTask(context.Background(), third, "claude", 0, d.logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(continued.Comment, secret) {
+		t.Fatal("continuation with the same repository grant lost its working data")
+	}
+}
+
+func TestTaskRepoGrantsRejectForgedPriorData(t *testing.T) {
+	for _, change := range []string{"unsigned", "changed_grant", "changed_directory", "missing"} {
+		t.Run(change, func(t *testing.T) {
+			d, _, cleanup := newLeaderReuseTestDaemon(t)
+			defer cleanup()
+			d.cfg.WorkspacesRoot = filepath.Join(t.TempDir(), "workspaces")
+			first := leaderReuseTestTask("untrusted-first")
+			first.Repos = []RepoData{{URL: "https://github.com/team/private-a.git"}}
+			prior, err := d.runTask(context.Background(), first, "claude", 0, d.logger)
+			if err != nil {
+				t.Fatal(err)
+			}
+			const secret = "untrusted-prior-work"
+			if err := os.WriteFile(filepath.Join(prior.WorkDir, "protected-repository-data"), []byte(secret), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			canonical, err := filepath.EvalSymlinks(prior.EnvRoot)
+			if err != nil {
+				t.Fatal(err)
+			}
+			recordPath := filepath.Join(d.cfg.WorkspacesRoot, ".runtime-controller", "repo-grants", taskRepoGrantName(canonical))
+			second := leaderReuseTestTask("untrusted-second")
+			second.Repos = first.Repos
+			second.PriorWorkDir, second.PriorSessionID = prior.WorkDir, prior.SessionID
+			switch change {
+			case "missing":
+				if err := os.Remove(recordPath); err != nil {
+					t.Fatal(err)
+				}
+			case "unsigned", "changed_grant":
+				data, err := os.ReadFile(recordPath)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var record signedTaskRepoGrant
+				if err := json.Unmarshal(data, &record); err != nil {
+					t.Fatal(err)
+				}
+				if change == "unsigned" {
+					record.Signature = ""
+				} else {
+					second.Repos = []RepoData{{URL: "https://github.com/team/private-b.git"}}
+					record.Grant.Repos = []string{second.Repos[0].URL}
+				}
+				data, err = json.Marshal(record)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(recordPath, data, 0o600); err != nil {
+					t.Fatal(err)
+				}
+			case "changed_directory":
+				backup := prior.EnvRoot + ".preserved"
+				if err := os.Rename(prior.EnvRoot, backup); err != nil {
+					t.Fatal(err)
+				}
+				writeLeaderTaskMarker(t, prior.WorkDir, first.AgentID, first.IssueID)
+				if err := execenv.WriteManagedEnvProvenance(prior.EnvRoot, execenv.ManagedEnvProvenance{
+					WorkspaceID: first.WorkspaceID, IssueID: first.IssueID, AgentID: first.AgentID,
+				}); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(prior.WorkDir, "protected-repository-data"), []byte(secret), 0o600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			bin := d.cfg.Agents["claude"].Path
+			script := `#!/bin/sh
+IFS= read -r _
+content=clean
+if [ -f protected-repository-data ]; then content=$(cat protected-repository-data); fi
+printf '{"type":"result","subtype":"success","is_error":false,"result":"%s"}\n' "$content"
+`
+			if err := os.WriteFile(bin, []byte(script), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			result, err := d.runTask(context.Background(), second, "claude", 0, d.logger)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(result.Comment, secret) {
+				t.Fatal("worker-controlled or unproven metadata authorized prior task data")
+			}
+		})
+	}
+}
+
+func TestTaskRepoGrantsPreserveUnknownRetryData(t *testing.T) {
+	d, _, cleanup := newLeaderReuseTestDaemon(t)
+	defer cleanup()
+	d.cfg.WorkspacesRoot = filepath.Join(t.TempDir(), "workspaces")
+	task := leaderReuseTestTask("same-task-retry")
+	task.Repos = []RepoData{{URL: "https://github.com/team/private-a.git"}}
+	prior, err := d.runTask(context.Background(), task, "claude", 0, d.logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	protected := filepath.Join(prior.WorkDir, "protected-repository-data")
+	const secret = "prior-task-uncommitted-work"
+	if err := os.WriteFile(protected, []byte(secret), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	task.Repos = []RepoData{{URL: "https://github.com/team/private-b.git"}}
+	if _, err := d.runTask(context.Background(), task, "claude", 0, d.logger); err == nil {
+		t.Fatal("same-task retry was allowed to reset work under a different repository grant")
+	}
+	data, err := os.ReadFile(protected)
+	if err != nil || string(data) != secret {
+		t.Fatalf("denied retry damaged uncommitted prior work: %q, %v", data, err)
+	}
+}
