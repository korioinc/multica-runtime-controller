+func TestTaskRepoGrantsCannotLaunchWithoutDurableProof(t *testing.T) {
+	d, _, cleanup := newLeaderReuseTestDaemon(t)
+	defer cleanup()
+	d.cfg.WorkspacesRoot = filepath.Join(t.TempDir(), "workspaces")
+	if err := os.MkdirAll(d.cfg.WorkspacesRoot, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	outside := t.TempDir()
+	protected := filepath.Join(outside, "protected-data")
+	if err := os.WriteFile(protected, []byte("untouched"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(d.cfg.WorkspacesRoot, ".runtime-controller")); err != nil {
+		t.Fatal(err)
+	}
+	bin := d.cfg.Agents["claude"].Path
+	script := fmt.Sprintf(`#!/bin/sh
+if [ "$1" = --version ]; then printf '2.0.0\n'; exit 0; fi
+IFS= read -r _
+printf 'provider-started' > %q
+printf '%%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"done"}'
+`, protected)
+	if err := os.WriteFile(bin, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := d.runTask(context.Background(), leaderReuseTestTask("unsafe-registry"), "claude", 0, d.logger); err == nil {
+		t.Fatal("task ran without successfully recording a controller-owned repository grant")
+	}
+	data, err := os.ReadFile(protected)
+	if err != nil || string(data) != "untouched" {
+		t.Fatalf("provider was allowed to act without a durable grant: %q, %v", data, err)
+	}
+}
